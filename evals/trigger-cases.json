{
  "eval_version": "1.0",
  "cases": [
    {
      "id": "positive-resume-paper-metrics",
      "prompt": "对比同一光伏项目的简历和论文，核对数据量、模型名和 mAP，并建立事实总账。",
      "should_trigger": true,
      "expected_sequence": ["scan", "extract", "compare", "ledger", "validate", "report"]
    },
    {
      "id": "positive-ppt-readme-stale",
      "prompt": "README 和答辩 PPT 对同一模块叫法不一致，请判断是否过期并给出处位置。",
      "should_trigger": true,
      "expected_sequence": ["scan", "extract", "compare", "ledger", "validate", "report"]
    },
    {
      "id": "positive-config-paper-threshold",
      "prompt": "核对训练配置、实验日志和论文表格中的 IoU 阈值、模型版本和结果。",
      "should_trigger": true,
      "expected_sequence": ["scan", "extract", "compare", "ledger", "validate", "report"]
    },
    {
      "id": "positive-contribution-audit",
      "prompt": "检查简历个人贡献与团队分工记录是否冲突，不要扩大我的工作。",
      "should_trigger": true,
      "expected_sequence": ["scan", "extract", "compare", "ledger", "validate", "report"]
    },
    {
      "id": "positive-second-run",
      "prompt": "用新增实验结果更新已有 project-facts.json，保留我上次确认的裁决。",
      "should_trigger": true,
      "expected_sequence": ["scan", "extract", "compare", "ledger", "validate", "report"]
    },
    {
      "id": "negative-single-polish",
      "prompt": "把这一篇论文的摘要润色成 Nature 风格英文。",
      "should_trigger": false,
